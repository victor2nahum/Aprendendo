#Estoque de produtos

from decimal import Decimal
produtos = []

while True:
  print("\n ===== ESTOQUE DE PRODUTOS =====")
  print("1 - Cadastrar Produtos")
  print("2 - Listar Produtos")
  print("3 - Ranking de Preços")
  print("4 - Valor Total do Estoque")
  print("5 - Ver Produtos com Estoque Baixo")
  print("6 - Buscar Produto")
  print("7 - Atualizar Produto")
  print("8 - Excluir Produto")
  print("9 - Sair")
  try:
    opcao = int(input("Escolha a opção: "))

    if opcao == 1:
      print("Voce escolheu cadastrar produto")

      name = input("Digite o nome do produto: ")
      value = Decimal(input("Digite o preço do produto: "))
      qntd = int(input("Digite a quantidade em estoque: "))
      category = input("Digite a categoria: ")

      product = {
        "Nome": name,
        "Preço": value,
        "Quantidade": qntd,
        "Categoria": category
      }

      produtos.append(product)

    elif opcao == 2:
      print("Voce escolheu listar produtos")

      if not produtos:
        print("Nenhum produto cadastrado")
      
      else:
        print("\n===== PRODUTOS CADASTRADOS =====")
        for posicao,product in enumerate(produtos, start=1):
          print(
            f"Posição: {posicao}",
            f"Nome: {product['Nome']}",
            f"Preço: R$ {product['Preço']:.2f}",
            f"Quantidade: {product['Quantidade']}",
            f"Categoria: {product['Categoria']}"
          )

    elif opcao == 3:
      if not produtos:
        print("Nenhum produto cadastrado")

      else:
        menor = min(produtos, key=lambda x: x["Preço"])
        print(f"Produto mais barato: {menor['Nome']} - R$ {menor['Preço']:.2f}")
        maior = max(produtos, key=lambda x: x["Preço"])
        print(f"Produto mais caro: {maior['Nome']} - R$ {maior['Preço']:.2f}")

      print("\n ===== RANKING DE PREÇOS =====")
      ranking = sorted(produtos, key=lambda x: x["Preço"], reverse = True)
      for posicao, item in enumerate(ranking, start=1):
        print(
              f"{posicao} - ",
              f"Nome: {item['Nome']}",
              f"Preço: R$ {item['Preço']:.2f}"
          )

    elif opcao == 4:
      if not produtos:
        print("Nenhum produto cadastrado")

      else:
        total_value = Decimal("0")

        for product in produtos:
          item_value = product["Preço"])
          item_qntd = product["Quantidade"]

          total_value += (item_value * item_qntd)

        print(f"Valor total do estoque: R$ {total_value:.2f}")


    elif opcao == 5:
      low_inventory = 0
      if not produtos:
        print("Nenhum produto cadastrado")

      else:
        limit = int(input("Digite o limite de estoque: "))
        print("\n ===== Produtos com Estoque Baixo =====")

        for posicao, product in enumerate(produtos, start=1):
          if product["Quantidade"] <= limit:
            low_inventory += 1
            print(f"{posicao} - Produto: {product['Nome']} - Estoque: {product['Quantidade']} unidades")
        print(f"Total de produtos com estoque baixo: {low_inventory}")


    elif opcao == 6:

      if not produtos:
        print("Nenhum produto cadastrado")

      else:
        search_name = input("Digite o nome do produto: ")
        encontrado = False

        for product in produtos:
          if search_name.lower() in product["Nome"].lower():
            encontrado = True
            print(f"Produto Encontrado --> Nome:{product['Nome']} - Preço: R$ {product['Preço']} - Quantidade: {product['Quantidade']} - Categoria: {product['Categoria']}")

        if not encontrado:
          print("Produto não encontrado")

    elif opcao == 7:

      if not produtos:
        print("Nenhum produto cadastrado")

      else:
        update = input("Digite o nome do produto que deseja atualizar: ")
        resultados = []

        for product in produtos:
          if update.lower() in product["Nome"].lower():
            print(f"Produto Encontrado --> Nome:{product['Nome']} - Preço: R$ {product['Preço']} - Quantidade: {product['Quantidade']} - Categoria: {product['Categoria']}")
            resultados.append(product)

        print(f"Produtos encontrados: {len(resultados)}")
        for posicao, product_res in enumerate(resultados, start=1):
          print(f"{posicao} - {product_res['Nome']}")

        if not resultados:
          print("Produto não encontrado")

        else:
          while True:
            try:
              mudar_res = int(input("Digite o número do produto que deseja atualizar: "))
              indice = mudar_res - 1
              if indice < 0:
                print("Erro: digite um número do índice")

              elif indice > (len(resultados)-1):
                print("Erro: digite um número do índice")

              else:
                produto_escolhido = resultados[indice]
                print(f"Você escolheu: {produto_escolhido['Nome']}")
                break

            except ValueError:
              print("Erro: Digite um número válido")

      
          newvalue = Decimal(input("Digite o novo preço: "))
          produto_escolhido["Preço"] = newvalue
          newqntd = int(input("Digite a nova quantidade: "))
          produto_escolhido["Quantidade"] = newqntd
          newcategory = input("Digite a nova categoria: ")
          produto_escolhido["Categoria"] = newcategory

          print("Todas as alterações foram cadastradas")

    elif opcao == 8:

      if not produtos:
        print("Nenhum produto cadastrado")

      else:
        delete = input("Digite o nome do produto que deseja excluir: ")
        excluidos = []

        for product in produtos:
          if delete.lower() in product["Nome"].lower():
            print(f"Produto Encontrado --> Nome:{product['Nome']} - Preço: R$ {product['Preço']} - Quantidade: {product['Quantidade']} - Categoria: {product['Categoria']}")
            excluidos.append(product)

        print(f"Produtos encontrados: {len(excluidos)}")
        for posicao, product_res in enumerate(excluidos, start=1):
          print(f"{posicao} - {product_res['Nome']}")

        if not excluidos:
          print("Produto não encontrado")

        else:
          while True:
            try:
              exclude_res = int(input("Digite o número do produto que deseja excluir: "))
              indice_exc = exclude_res - 1
              if indice_exc < 0:
                print("Erro: digite um número do índice")

              elif indice_exc > (len(excluidos)-1):
                print("Erro: digite um número do índice")

              else:
                produto_excluido = excluidos[indice_exc]
                print(f"Você escolheu: {produto_excluido['Nome']}")
                confirm = input("Confirma? Digite sim para excluir e não para retornar") 

                if confirm.lower() == "sim":
                  produtos.remove(produto_excluido)
                  print("Produto excluído com sucesso")
                  break

                elif confirm.lower() == "não":
                  print("Retornando ao menu")
                  break

                else: 
                  print("Digite sim ou não")
                
            except ValueError:
              print("Erro: Digite um número válido")



    elif opcao == 9:
      print("Programa encerrado")
      break

    else: 
      print("Erro: escolha uma opção entre 1 e 3")

  except ValueError:
    print("Erro: digite um número válido no menu")
