 print(quiz["Pergunta"])

 print("\n===== Alternativas =====")
 print(quiz["A"])
 print(quiz["B"])
 print(quiz["C"])
 print(quiz["D"])

 while True:
  resp = input("Digite sua resposta: ").upper()
  if resp in ["A", "B", "C", "D"]:
