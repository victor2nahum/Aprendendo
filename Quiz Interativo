#Jogo Quiz Interativo

def cadastrar_pergunta():
 pergunta = input("Digite a pergunta: ")
 alternativa_a = "A - "+input("Digite a alternativa A: ")
 alternativa_b = "B - "+input("Digite a alternativa B: ")
 alternativa_c = "C - "+input("Digite a alternativa C: ")
 alternativa_d = "D - "+input("Digite a alternativa D: ")
 while True:
  resposta = input("Digite a alternativa correta: ")
  if resposta in ["A", "B", "C", "D"]:
   break
  else:
   print("Digite uma alternativa válida")

 quiz = {
        "Pergunta": pergunta,
        "A": alternativa_a,
        "B": alternativa_b,
        "C": alternativa_c,
        "D": alternativa_d,
        "Resposta": resposta
      }

 return quiz

perguntas = []
pontuacao = 0

while True:
 quiz = cadastrar_pergunta()
 perguntas.append(quiz)

 seguir = input("Deseja cadastrar uma nova pergunta? S/N:")
 if seguir == "N":
  break

for posicao, quiz in enumerate (perguntas, start=1):
        print(f"\n===== PERGUNTA {posicao} DE {len(perguntas)} =====")
        print(quiz["Pergunta"])

        print("\n===== Alternativas =====")
        print(quiz["A"])
        print(quiz["B"])
        print(quiz["C"])
        print(quiz["D"])

        while True:
          resp = input("Digite sua resposta: ").upper()
          if resp in ["A", "B", "C", "D"]:
            print(f"Você escolheu: {quiz[resp]}")
            break
          else:
            print("Digite uma opçao válida")

        if resp == quiz["Resposta"]:
          print("Certa Resposta")
          pontuacao += 1

        else:
          print("Resposta Errada")

print("\n ==== RESULTADO ====")
print(f"Você acertou {pontuacao} de {len(perguntas)} perguntas!")
percentual = 100* (pontuacao/len(perguntas))
print(f"Você acertou {percentual:.0f}%")
