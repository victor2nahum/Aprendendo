# GERENCIADOR DE TAREFAS

tarefas = []

while True:
  print("\n ====== MENU - GERENCIADOR DE TAREFAS ======")
  print("1 - Adicionar Tarefa")
  print("2 - Listar Tarefas")
  print("3 - Atualizar Status")
  print("4 - Remover Tarefa")
  print("5 - Sair")

  menu = int(input("Digite a opção do menu: "))
  if menu == 1:
    add = input("Digite uma tarefa: ")
    tarefas.append(add)

    while True:
      confirm = input("Deseja digitar nova tarefa? S/N?").upper()

      if confirm == "S":
        add_new = input("Digite outra tarefa: ")
        tarefas.append(add_new)
      elif confirm == "N":
        break
      else:
        print("Digite S ou N")

  elif menu == 2:
    print("\n ===== TAREFAS =====")
    for item in tarefas:
      print(item)

  elif menu == 3:

  elif menu == 4:

  elif menu == 5:

  else:
    print("Digite uma opção válida")

except ValueError:
  print("Digite um número válido )
