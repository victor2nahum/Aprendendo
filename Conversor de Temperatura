#Conversor de Temperatura

#---------------------      MENU       -------------------------

while True:
      print("\n====== CONVERSOR DE TEMPERATURAS =======")
      print("1 - Celsius --> Fahrenheit")
      print("2 - Fahrenheit --> Celsius")
      print("3 - Sair")
      try:
       opcao = int(input("Escolha a opção: "))

       if opcao == 1:
          print("Voce escolheu Celsius --> Fahrenheit")
          try:
		cel = float(input("Digite a temperatura em Celsius: "))
          	fah = (cel*9.5)+32
          	print(f"{cel}ºC = {fah}ºF")
	  except ValueError:
		print("Erro: digite uma temperatura válida.")

       elif opcao == 2:
          print("Voce escolheu Fahrenheit --> Celsius")
          try:
		fah = float(input("Digite a temperatura em Fahrenheit: "))
          	cel = (fah-32)*(5/9)
                print(f"{fah}ºF = {cel}ºC")
	  except ValueError:
		print("Erro: digite uma temperatura válida.")

       elif opcao == 3:
          print("Programa encerrado")
          break

       else: 
          print("Erro: escolha uma opção entre 1 e 3")

      except ValueError:
          print("Erro: digite um número válido no menu")
